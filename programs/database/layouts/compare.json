{
  "schema": 1,
  "id": "database-table-comparison",
  "root": {
    "id": "comparison",
    "type": "stack",
    "children": [
      {
        "id": "overview",
        "type": "detail",
        "title": {
          "package": "the8020/admin-db",
          "key": "layouts.database.compare.overview.title",
          "fallback": "Comparison"
        },
        "controls": [
          "tableId",
          "definitionState",
          "deployedCommit",
          "activatedCommit",
          "result",
          "attention"
        ]
      },
      {
        "id": "columns",
        "type": "list",
        "title": {
          "package": "the8020/admin-db",
          "key": "catalog.fields",
          "fallback": "Fields"
        },
        "bind": "columns",
        "key": "key",
        "display": [
          "name",
          "change",
          "activated",
          "deployed",
          "database"
        ]
      },
      {
        "id": "indexes",
        "type": "list",
        "title": {
          "package": "the8020/admin-db",
          "key": "layouts.database.advanced.indexes.title",
          "fallback": "Indexes"
        },
        "bind": "indexes",
        "key": "key",
        "display": [
          "name",
          "change",
          "activated",
          "deployed",
          "database"
        ]
      },
      {
        "id": "differences",
        "type": "list",
        "title": {
          "package": "the8020/admin-db",
          "key": "layouts.database.advanced.differences.title",
          "fallback": "Detected differences"
        },
        "bind": "differences",
        "key": "key",
        "display": [
          "status",
          "issue"
        ],
        "columnOptions": {
          "issue": {
            "length": "long"
          }
        }
      }
    ]
  }
}
