{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check programs/database/program.ts programs/browse/program.ts programs/sql/program.ts && deno task check:i18n",
    "test": "deno test --allow-read=. .",
    "check:i18n": "deno run --allow-read ../i18n/check.ts --complete=cs ."
  }
}
