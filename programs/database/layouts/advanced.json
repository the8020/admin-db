{
  "schema": 1,
  "id": "database-table-advanced",
  "root": {
    "id": "table",
    "type": "stack",
    "children": [
      {
        "id": "overview",
        "type": "detail",
        "title": {
          "package": "the8020/admin-db",
          "key": "layouts.database.advanced.overview.title",
          "fallback": "Overview"
        },
        "controls": [
          "package",
          "tableName",
          "physicalTable",
          "tableState",
          "schemaState",
          "sourceCommit",
          "sourceModule",
          "synchronizedAt",
          "fields",
          "attention"
        ]
      },
      {
        "id": "columns",
        "type": "list",
        "title": {
          "package": "the8020/admin-db",
          "key": "catalog.fields",
          "fallback": "Fields"
        },
        "bind": "columns",
        "key": "key",
        "display": [
          "name",
          "state",
          "logicalType",
          "databaseType",
          "required",
          "defaultValue",
          "databaseDefault",
          "constraints",
          "reference"
        ],
        "columnOptions": {
          "constraints": {
            "length": "long"
          },
          "reference": {
            "length": "long"
          }
        }
      },
      {
        "id": "indexes",
        "type": "list",
        "title": {
          "package": "the8020/admin-db",
          "key": "layouts.database.advanced.indexes.title",
          "fallback": "Indexes"
        },
        "bind": "indexes",
        "key": "key",
        "display": [
          "name",
          "state",
          "columns",
          "unique"
        ]
      },
      {
        "id": "checks",
        "type": "list",
        "title": {
          "package": "the8020/admin-db",
          "key": "layouts.database.advanced.checks.title",
          "fallback": "Database checks"
        },
        "bind": "checks",
        "key": "key",
        "display": [
          "expression"
        ],
        "columnOptions": {
          "expression": {
            "length": "long"
          }
        }
      },
      {
        "id": "differences",
        "type": "list",
        "title": {
          "package": "the8020/admin-db",
          "key": "layouts.database.advanced.differences.title",
          "fallback": "Detected differences"
        },
        "bind": "differences",
        "key": "key",
        "display": [
          "status",
          "issue"
        ],
        "columnOptions": {
          "issue": {
            "length": "long"
          }
        }
      }
    ]
  }
}
