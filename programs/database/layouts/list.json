{
  "schema": 1,
  "id": "database-tables",
  "root": {
    "id": "tables",
    "type": "list",
    "bind": "tables",
    "key": "navigation",
    "display": [
      "package",
      "table",
      "state",
      "activeColumns",
      "alert"
    ],
    "columnOptions": {
      "package": {
        "length": "long"
      },
      "table": {
        "length": "medium"
      },
      "activeColumns": {
        "length": "short"
      },
      "alert": {
        "length": "long"
      }
    },
    "toolbar": [
      {
        "id": "refresh",
        "label": {
          "package": "the8020/admin-db",
          "key": "program.refresh",
          "fallback": "[[icon=refresh]] Refresh"
        }
      }
    ]
  }
}
